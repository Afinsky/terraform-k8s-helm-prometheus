# Copy to secure_variables.tfvars (already gitignored) and fill in real values.
# Leaving domain_registrant_contact unset (or absent) keeps aws_route53domains_domain
# disabled, so plain `terraform apply` on this environment won't accidentally
# purchase local.zone_name from route53.tf.

domain_registrant_contact = {
  first_name      = "Jane"
  last_name       = "Doe"
  contact_type    = "PERSON"
  address_line_1  = "123 Main St"
  city            = "Berlin"
  zip_code        = "10115"
  country_code    = "DE"
  email           = "jane.doe@example.com"
  phone_number    = "+49.15112345678"
}
